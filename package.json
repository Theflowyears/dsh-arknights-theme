{
  "name": "dsh-arknights-theme",
  "version": "1.1.2",
  "description": "支持导入本地图片作壁纸（导入即解算玻璃浓度与文字色），并内置 12 张按画面自适应的整屏壁纸；罗德岛图标体系与签名式的授权、选择交互。 / Import your own local picture as a wallpaper — glass and ink are solved on import — alongside twelve full-screen wallpapers with per-image edge blur, glass and ink solved from each picture, Rhodes Island iconography, and sign-off style approval and choice interactions.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icons/amiya-mark.svg",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./wallpapers.json": "./assets/wallpapers.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/*.webp",
    "assets/*.json",
    "assets/*.css",
    "assets/signatures",
    "icons",
    "cordis.patch.yml",
    "README.md",
    "ICON-ATTRIBUTION.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "arknights",
    "rhodes-island",
    "wallpaper",
    "theme",
    "immersion",
    "acrylic"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Theflowyears/dsh-arknights-theme.git"
  },
  "homepage": "https://github.com/Theflowyears/dsh-arknights-theme#readme",
  "bugs": {
    "url": "https://github.com/Theflowyears/dsh-arknights-theme/issues"
  },
  "author": "Theflowyears"
}
