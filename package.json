{
  "name": "dsh-arknights-theme",
  "version": "1.0.0",
  "description": "为《明日方舟》玩家在 DSH Web 上构建沉浸感：12 张整屏壁纸（按画面自适应的边缘虚化）、按每张图解算的玻璃与文字色、罗德岛图标体系，以及签字式的授权与选择交互。 / Building immersion for Arknights players on the DSH Web GUI: twelve full-screen wallpapers with per-image edge blur, glass and ink solved from each picture, Rhodes Island iconography, and sign-off style approval and choice interactions.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icons/amiya-mark.svg",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./wallpapers.json": "./assets/wallpapers.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/*.webp",
    "assets/*.json",
    "assets/*.css",
    "assets/signatures",
    "icons",
    "cordis.patch.yml",
    "README.md",
    "ICON-ATTRIBUTION.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "arknights",
    "rhodes-island",
    "wallpaper",
    "theme",
    "immersion",
    "acrylic"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Theflowyears/dsh-arknights-theme.git"
  },
  "homepage": "https://github.com/Theflowyears/dsh-arknights-theme#readme",
  "bugs": {
    "url": "https://github.com/Theflowyears/dsh-arknights-theme/issues"
  },
  "author": "Theflowyears"
}
